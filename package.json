{
  "name": "dsh-codex-ui",
  "version": "0.1.0",
  "description": "Codex-style rail and navigation shell for the DeepSeek Harness Web UI.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "ui",
    "sidebar",
    "codex"
  ],
  "homepage": "https://github.com/richyhu/dsh-codex-ui#readme",
  "bugs": {
    "url": "https://github.com/richyhu/dsh-codex-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richyhu/dsh-codex-ui.git"
  },
  "license": "MIT",
  "author": "richyhu",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs/NOTES.md",
    "docs/VERIFY.md",
    "docs/PUBLISH.md",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  }
}
